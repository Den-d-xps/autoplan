{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "autoplan",
  "version": "0.9.0",
  "identifier": "dd.autoplan.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run build:scripts && npm run dev",
    "beforeBuildCommand": "npm run build:scripts && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "autoplan",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": {
      "../automation/dist/scripts/": "scripts/",
      "../automation/dist/constants/": "constants/",
      "../automation/chromium/": "chromium/",
      "../node_modules/playwright/": "node_modules/playwright/",
      "../node_modules/playwright-core/": "node_modules/playwright-core/"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
